# OpenCluely environment template

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
# Available models: gemini-3.6-flash or gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.6-flash
# Thinking level: minimal, low, medium, or high
GEMINI_THINKING_LEVEL=medium

# Mobile pairing stays local by default. Enable only on a trusted LAN;
# the pairing URL is HTTP and its generated token acts as the bearer secret.
OPENCLUEY_MOBILE_SYNC_LAN=0

# Speech provider: whisper (local) or azure (cloud)
SPEECH_PROVIDER=whisper
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here

# Local Whisper defaults to whisper.cpp so AMD/NVIDIA/Intel Vulkan can be used.
# Runtime fallback: Faster Whisper CPU int8, then OpenAI Whisper CLI.
WHISPER_ENGINE=whisper-cpp
WHISPER_COMMAND=
WHISPER_MODEL=turbo
WHISPER_LANGUAGE=pt
WHISPER_SEGMENT_MS=4000
WHISPER_PERIODIC_FLUSH_MS=3000
WHISPER_SILENCE_HANGOVER_MS=600
WHISPER_CAPTURE_CHUNK_SAMPLES=2048

# Faster Whisper settings (only used when WHISPER_ENGINE=faster)
WHISPER_FASTER_DEVICE=cpu
WHISPER_FASTER_COMPUTE_TYPE=int8

# whisper.cpp settings (only used when WHISPER_ENGINE=whisper-cpp)
WHISPER_CPP_COMMAND=
WHISPER_CPP_SERVER_COMMAND=
WHISPER_CPP_PYTHON=
WHISPER_CPP_THREADS=12
WHISPER_CPP_BLAS=auto
# vulkan (recommended for Radeon RX 6600), auto, or cpu
WHISPER_CPP_BACKEND=vulkan
# auto selects a discrete Vulkan adapter; use 0 for the RX 6600 on this PC
WHISPER_CPP_DEVICE=auto
WHISPER_CPP_BEAM_SIZE=1
WHISPER_CPP_BEST_OF=1
WHISPER_CPP_NO_FALLBACK=true
WHISPER_CPP_FLASH_ATTENTION=true
# Optional absolute paths
# WHISPER_CPP_MODEL_DIR=
# WHISPER_CPP_MODEL=

# Faster Whisper batching
WHISPER_BATCH_SIZE=4
WHISPER_BATCH_TIMEOUT_MS=2000
WHISPER_MAX_CONCURRENT=4
WHISPER_BEAM_SIZE=5

# Optional absolute model directory override
# WHISPER_MODEL_DIR=
